{
  "name": "digital-ticket-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build --config vite.standalone.config.ts",
    "dev": "wrangler dev --config wrangler.local.jsonc --local --persist-to .wrangler/standalone",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/sla.test.mjs tests/migration.test.mjs",
    "test:api": "node tests/standalone-api.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/standalone",
    "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.local.jsonc",
    "deploy": "npm run build && wrangler deploy --config wrangler.local.jsonc"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "@cloudflare/workers-types": "4.20260515.1",
    "wrangler": "4.92.0",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1"
  }
}
