{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digital-ticket-portal",
  "main": "standalone/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/standalone/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ticket-portal-db",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": "standalone/migrations"
  }],
  "vars": { "PUBLIC_DEMO": "true" }
  // Optional R2: activate only after reviewing Cloudflare's subscription/usage terms.
  // ,"r2_buckets": [{"binding":"BUCKET","bucket_name":"ticket-portal-files"}]
}
